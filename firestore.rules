rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Authentication & Role-Based Access Control (RBAC) Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return isSignedIn() ? getUserData().role : null;
    }

    // Role Hierarchy & Separation of Duties (مطابقة تماماً لمنطق السيرفر checkEntityAccess):
    // 1. ADMIN (مدير النظام والشريك المسؤول - كامل الصلاحيات)
    function isAdmin() {
      return isSignedIn() && getUserRole() == 'ADMIN';
    }

    // 2. ACCOUNTANT (محاسب مالي - صلاحيات الإضافة والتعديل والترحيل)
    // لا يضم AUDITOR نهائياً
    function isAccountant() {
      return isSignedIn() && (isAdmin() || getUserRole() == 'ACCOUNTANT');
    }

    // 3. AUDITOR (مراجع ومراقب حسابات - قراءة وفحص وتدقيق فقط دون أي صلاحيات كتابة أو تعديل)
    function isAuditor() {
      return isSignedIn() && getUserRole() == 'AUDITOR';
    }

    // 4. SECRETARY (سكرتارية واستقبال - فواتير وموكلين وشهادات فقط)
    function isSecretary() {
      return isSignedIn() && getUserRole() == 'SECRETARY';
    }

    // صلاحية قراءة السجلات المحاسبية والمالية العامة (متاحة للمدير والمحاسب والمراجع القانوني)
    function canReadStandard() {
      return isSignedIn() && (isAdmin() || getUserRole() == 'ACCOUNTANT' || getUserRole() == 'AUDITOR');
    }

    // شرط الحذف: مقتصر على المدير، أو المحاسب الحاصل على إذن الحذف الصريح canDeleteRecords
    function canDeleteStandard() {
      return isSignedIn() && (isAdmin() || (getUserRole() == 'ACCOUNTANT' && getUserData().canDeleteRecords == true));
    }

    function hasRole() {
      return isSignedIn() && getUserRole() != 'PENDING' && getUserRole() != null;
    }

    // --- 1. User Profiles & Permissions ---
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId &&
        request.resource.data.role == 'PENDING' &&
        request.resource.data.canManageUsers == false &&
        request.resource.data.canAccessTreasury == false &&
        request.resource.data.canAccessAuditTrail == false &&
        request.resource.data.canPostEntries == false &&
        request.resource.data.canEditPostedEntries == false &&
        request.resource.data.canDeleteRecords == false &&
        request.resource.data.canAccessCreditFiles == false &&
        request.resource.data.canAccessTaxReports == false;
      allow update: if isSignedIn() && (
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'canManageUsers', 'canAccessTreasury', 'canAccessAuditTrail', 'canPostEntries', 'canEditPostedEntries', 'canDeleteRecords', 'canAccessCreditFiles', 'canAccessTaxReports'])) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // --- 2. Clients Dossiers & Tax Archives (ملفات الموكلين) ---
    match /clients/{clientId} {
      allow read: if canReadStandard() || isSecretary();
      allow create, update: if isAccountant();
      allow delete: if canDeleteStandard();
    }

    // --- 3. Journal Entries (قيود اليومية - ممنوعة تماماً عن المراجع AUDITOR والسكرتارية) ---
    match /journalEntries/{entryId} {
      allow read: if canReadStandard();
      allow create, update: if isAccountant();
      allow delete: if canDeleteStandard();
    }

    // --- 4. Office Treasury & Cash Box (خزنة المكتب) ---
    match /treasury/{txId} {
      allow read: if isAdmin() || (getUserData().canAccessTreasury == true && (getUserRole() == 'ACCOUNTANT' || getUserRole() == 'AUDITOR' || getUserRole() == 'SECRETARY'));
      allow create, update: if isAdmin() || (isAccountant() && getUserData().canAccessTreasury == true);
      allow delete: if isAdmin() || (isAccountant() && getUserData().canAccessTreasury == true && getUserData().canDeleteRecords == true);
    }

    // --- 5. Tax Declarations & Returns (الإقرارات الضريبية) ---
    match /taxDeclarations/{declId} {
      allow read: if canReadStandard();
      allow create, update: if isAccountant();
      allow delete: if canDeleteStandard();
    }

    // --- 6. Tax Audits (الفحص الضريبي ولجان الطعن) ---
    match /taxAudits/{auditId} {
      allow read: if canReadStandard();
      allow create, update: if isAccountant();
      allow delete: if canDeleteStandard();
    }

    // --- 7. Chart of Accounts (دليل الحسابات - ممنوع تعديله على AUDITOR) ---
    match /accounts/{accountId} {
      allow read: if canReadStandard();
      allow create, update: if isAccountant();
      allow delete: if canDeleteStandard();
    }

    // --- 8. Professional Invoices (فواتير الأتعاب والمبيعات) ---
    match /invoices/{invoiceId} {
      allow read: if canReadStandard() || isSecretary();
      allow create, update: if isAccountant() || isSecretary();
      allow delete: if canDeleteStandard();
    }

    // --- 9. Certified Certificates & Reports (الشهادات والتقارير المعتمدة) ---
    match /certificates/{certId} {
      allow read: if canReadStandard() || isSecretary();
      allow create, update: if isAccountant();
      allow delete: if canDeleteStandard();
    }

    // --- 10. Financial Statements (القوائم المالية والمركز المالي) ---
    match /financialStatements/{statementId} {
      allow read: if canReadStandard();
      allow create, update: if isAccountant();
      allow delete: if canDeleteStandard();
    }

    // --- 11. Audit Trail Logs (سجل العمليات والرقابة) ---
    match /auditLogs/{logId} {
      allow read: if isAdmin() || (isAuditor() && getUserData().canAccessAuditTrail == true);
      allow create: if hasRole() && 
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.keys().hasAll(['userId', 'action', 'entity', 'timestamp']) &&
        request.resource.data.userId is string &&
        request.resource.data.action is string &&
        request.resource.data.entity is string &&
        request.resource.data.timestamp is string &&
        request.resource.data.action.size() <= 100 &&
        request.resource.data.entity.size() <= 100 &&
        (request.resource.data.get('details', '') is string && request.resource.data.get('details', '').size() <= 2000);
      allow update, delete: if false;
    }

    // --- 12. Office Profile & Settings (ملف المكتب وإعداداته - للمدير فقط) ---
    match /officeProfile/{profileId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- 13. System Workspace Snapshots ---
    match /workspaces/{workspaceId} {
      allow read: if canReadStandard();
      allow write: if isAccountant();
    }
    match /accounting_workspaces/{workspaceId} {
      allow read: if canReadStandard();
      allow write: if isAccountant();
    }

    // --- 14. Issued Documents Verification Registry ---
    match /issuedDocuments/{docId} {
      allow get: if true;
      allow write: if isAccountant();
    }

    // --- 15. Closing Checklists (قوائم الإقفال المالي السنوي) ---
    match /closingChecklists/{checklistId} {
      allow read: if canReadStandard();
      allow create, update: if isAccountant();
      allow delete: if canDeleteStandard();
    }

    // --- 16. Client Deadlines (مواعيد واستحقاقات العملاء) ---
    match /clientDeadlines/{deadlineId} {
      allow read: if canReadStandard();
      allow create, update: if isAccountant();
      allow delete: if canDeleteStandard();
    }

    // --- 17. Open Items (البنود المفتوحة وملاحظات المراجعة) ---
    match /openItems/{itemId} {
      allow read: if canReadStandard();
      allow create, update: if isAccountant();
      allow delete: if canDeleteStandard();
    }

    // --- 18. Fiscal Period Locks (أقفال الفترات المالية - للمدير فقط) ---
    match /fiscalPeriodLocks/{lockId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- Default Deny All Unauthenticated or Unmatched Requests ---
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
