# ==============================================================================
# دليل متغيرات البيئة - منظومة المحاسب والمراجع القانوني (MG Account)
# ENVIRONMENT VARIABLES CONFIGURATION GUIDE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. متغيرات الأمان الأساسية الإجبارية في بيئة الإنتاج
# MANDATORY PRODUCTION SECURITY VARIABLES (REQUIRED FOR DEPLOYMENT)
# ------------------------------------------------------------------------------

# مفتاح التشفير الأساسي للبيانات الحساسة وبيانات الاعتماد (32 حرفاً على الأقل)
# Mandatory in production: Minimum 32 characters
CREDENTIALS_KEY="EXAMPLE_CREDENTIALS_KEY_MIN_32_CHARS_LONG_2026"

# كلمة المرور الرئيسية لتنظيف وتصفير قاعدة البيانات وتطهير السجلات (16 حرفاً على الأقل)
# Mandatory in production: Minimum 16 characters
# ملاحظة: الاسم المعتمد هو PASSWORD_PURGE_MASTER (ويدعم الكود أيضاً MASTER_PURGE_PASSWORD كاسم بديل)
PASSWORD_PURGE_MASTER="EXAMPLE_PURGE_MASTER_PASS_16_CHARS"
# MASTER_PURGE_PASSWORD="EXAMPLE_PURGE_MASTER_PASS_16_CHARS" # Alias for PASSWORD_PURGE_MASTER

# رمز التفعيل والترخيص الرسمي للأجهزة والمتصفحات المصرح لها (12 حرفاً على الأقل)
# Mandatory in production: Minimum 12 characters
DEVICE_ACTIVATION_CODE="MG-MASTER-ACTIVATION-2026-CODE"

# رمز الإعداد والتهيئة الأولية لحساب المدير عند التشغيل لأول مرة
# Mandatory in production: Used for initial setup/admin provisioning
SETUP_TOKEN="SETUP_MG_ACCOUNT_ADMIN_SECURE_TOKEN_2026"
# TOKEN_SETUP="SETUP_MG_ACCOUNT_ADMIN_SECURE_TOKEN_2026" # Alias for SETUP_TOKEN

# ------------------------------------------------------------------------------
# 2. مسارات التخزين الدائم (PERSISTENT STORAGE CONFIGURATION)
# ------------------------------------------------------------------------------

# مسار مجلد التخزين الدائم لقاعدة بيانات SQLite ومستندات العملاء والنسخ الاحتياطية.
# في بيئات الحاويات السحابية (مثل Cloud Run)، يجب ربط هذا المسار بقرص دائم (Persistent Volume)
# لمنع فقدان البيانات عند إعادة تشغيل الحاوية.
# Optional: Defaults to './data' inside the application directory
DATA_DIR="/data"

# مسار مخصص لملف قاعدة البيانات (اختياري - افتراضياً داخل DATA_DIR/app.db)
# DB_PATH="/data/app.db"

# مسار مخصص لمستندات وأرشيف العملاء (اختياري - افتراضياً داخل DATA_DIR/documents)
# DOCUMENTS_DIR="/data/documents"

# مسار مخصص للنسخ الاحتياطية التلقائية واليومية (اختياري - افتراضياً داخل DATA_DIR/backups)
# BACKUP_DIR="/data/backups"

# ------------------------------------------------------------------------------
# 3. تكامل الذكاء الاصطناعي (GOOGLE GEMINI AI CONFIGURATION)
# ------------------------------------------------------------------------------

# مفتاح Gemini API: يتم حقنه تلقائياً في منصة AI Studio من إعدادات الأسرار (Secrets)
# Automatically injected by AI Studio at runtime from user secrets
GEMINI_API_KEY=""

# نموذج Gemini الافتراضي لمعالجة المستندات والفحص الضريبي
GEMINI_MODEL="gemini-2.5-flash"

# رابط التطبيق العام (يتم حقنه تلقائياً في بيئة Cloud Run)
APP_URL=""

# منفذ تشغيل الخادم (الافتراضي 3000)
PORT="3000"

# ------------------------------------------------------------------------------
# 4. منظومة الفاتورة والإيصال الإلكتروني المصرية (ETA SDK v1.0)
# (مطلوبة فقط في حال تفعيل الميزة بوضع قيمة لـ ETA_CLIENT_ID، وتُعطل الميزة تلقائياً إذا تركت فارغة)
# ------------------------------------------------------------------------------

# بيئة مصلحة الضرائب: PREPROD للبيئة التجريبية، أو PROD لبيئة الإنتاج الفعلية
ETA_ENVIRONMENT="PREPROD"

# معرّف العميل لدى مصلحة الضرائب المصرية (إذا تُرِك فارغاً تُعطل وحدة ETA ولا يتوقف السيرفر)
ETA_CLIENT_ID=""

# السر الخاص بالعميل لدى مصلحة الضرائب (إجباري فقط إذا تم إدخال ETA_CLIENT_ID في الإنتاج)
ETA_CLIENT_SECRET=""

# الرقم السري لتوكن التوقيع الإلكتروني (USB Token PIN / HSM) (إجباري إذا تم إدخال ETA_CLIENT_ID)
ETA_TOKEN_PIN=""
# PIN_TOKEN_ETA="" # Alias for ETA_TOKEN_PIN

# بيانات الممول الأساسية المسجلة لدى مصلحة الضرائب المصرية
ETA_ISSUER_TAX_ID="100-200-300"
ETA_ISSUER_NAME="مكتب المحاسب والمراجع القانوني - محمد جميل مرعي وشركاه"
ETA_ACTIVITY_CODE="6920"
ETA_POS_SERIAL="POS-CAIRO-HQ-01"

# ------------------------------------------------------------------------------
# 5. تكامل خدمة واتساب السحابية للمكتب (META WHATSAPP BUSINESS CLOUD API)
# (اختياري - للمراسلات التلقائية وإشعارات العملاء)
# ------------------------------------------------------------------------------

WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_WABA_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""

# ------------------------------------------------------------------------------
# 6. مفاتيح إدارية إضافية (اختيارية)
# ADDITIONAL ADMINISTRATIVE KEYS
# ------------------------------------------------------------------------------

MASTER_EDIT_PASSWORD=""
BACKUP_SIGNATURE_KEY=""
